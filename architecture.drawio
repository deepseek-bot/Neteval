<mxfile host="Electron">
  <diagram name="NetEval Modular Architecture" id="pHbRUqJMy8sVMZJemDWC">
    <mxGraphModel dx="2188" dy="1162" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=13;align=left;spacingLeft=16;" value="&lt;b&gt;NetEval 模块化业务拓扑（v1.0.0 基准 + 后续版本扩展）&lt;/b&gt;　｜　&lt;font color=&quot;#B45309&quot;&gt;■ 实线暖色 = v1.0.0 核心闭环&lt;/font&gt;　｜　&lt;font color=&quot;#4B5563&quot;&gt;┄ 虚线灰框 = v1.1+ 按版扩展&lt;/font&gt;　｜　&lt;font color=&quot;#15803D&quot;&gt;原则：同级模块横向 0 互调，进程内协调全汇于 C1&lt;/font&gt;" vertex="1">
          <mxGeometry height="44" width="1400" x="360" y="220" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-2" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#F8FAFC;strokeColor=#2563EB;strokeWidth=2;rounded=1;arcSize=4;fontColor=#1E3A8A;fontSize=13;swimlaneFillColor=#F8FAFC;" value="&lt;b&gt;Client App（客户端进程：v1.0～v1.1 CLI / v1.2 Windows EXE &amp; Android APK，全套 Rust 共享核心）&lt;/b&gt;" vertex="1">
          <mxGeometry height="432" width="1040" x="360" y="284" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-3" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;spacing=6;" value="&lt;b&gt;U1 CLI (v1.0～v1.1) / U2 Win &amp; Android GUI (v1.2)&lt;/b&gt;&lt;br&gt;薄壳观察者：配置表单 / 实时折线图 / 历史查看 / Android 前后台中断上报&lt;br&gt;&lt;font color=&quot;#1D4ED8&quot;&gt;严禁绕过 C1 直调下属模块，不碰任何 Socket&lt;/font&gt;" vertex="1">
          <mxGeometry height="68" width="520" x="260" y="44" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-4" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontColor=#0F172A;fontSize=12;spacing=6;" value="&lt;b&gt;C1：任务编排中枢 (Orchestrator) [v1.0]&lt;/b&gt;&lt;br&gt;客户端唯一对外门面 &amp; 状态真相源：单任务互斥 / 串联下属模块 / 取消总闸 (&amp;lt;=500ms)&lt;br&gt;&lt;font color=&quot;#15803D&quot;&gt;打洞期双路汇合点：监听 C2 放哨事件 &amp;amp; 接收 C3 进展事件，统一发停机令&lt;/font&gt;" vertex="1">
          <mxGeometry height="76" width="600" x="220" y="150" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-5" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontColor=#111827;fontSize=11;spacing=4;" value="&lt;b&gt;C6：本地存储 [v1.0/v1.2]&lt;/b&gt;&lt;br&gt;(Local Store)&lt;br&gt;──────────&lt;br&gt;本地 JSON 报告读写清理&lt;br&gt;写盘失败不吞测完结果&lt;br&gt;&lt;i&gt;不碰网络 / 不做计算&lt;/i&gt;" vertex="1">
          <mxGeometry height="134" width="184" x="28" y="276" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-6" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1F2937;fontSize=11;spacing=4;" value="&lt;b&gt;C5：链路探测 [v1.3]&lt;/b&gt;&lt;br&gt;(Link Prober · 无状态)&lt;br&gt;──────────&lt;br&gt;指定 IP 直连 TCP / TLS+SNI&lt;br&gt;绕过 DNS 污染，免 ICMP&lt;br&gt;&lt;i&gt;不连自有服 / 不管 P2P&lt;/i&gt;" vertex="1">
          <mxGeometry height="134" width="184" x="228" y="276" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-7" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1F2937;fontSize=11;spacing=4;" value="&lt;b&gt;C2：信令客户端 [v1.1]&lt;/b&gt;&lt;br&gt;(Signaling Client)&lt;br&gt;──────────&lt;br&gt;进退房 / 换候选地址&lt;br&gt;打洞期放哨 peer_left&lt;br&gt;&lt;i&gt;不绑 UDP / 不发打洞包&lt;/i&gt;" vertex="1">
          <mxGeometry height="134" width="184" x="428" y="276" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-8" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontColor=#111827;fontSize=11;spacing=4;" value="&lt;b&gt;C4：NAT 画像 [v1.0]&lt;/b&gt;&lt;br&gt;(NAT Profiler · 无状态)&lt;br&gt;──────────&lt;br&gt;公共 STUN 零 VPS + 单机双端口&lt;br&gt;判定 NAT1~4 / IPv6 / 可选辅节点&lt;br&gt;&lt;i&gt;不配对 / 不打洞&lt;/i&gt;" vertex="1">
          <mxGeometry height="134" width="184" x="628" y="276" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-9" parent="yUIRf83ZdSQaIbvJiAPY-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1F2937;fontSize=11;spacing=4;" value="&lt;b&gt;C3：P2P 通道体检 [v1.1]&lt;/b&gt;&lt;br&gt;(P2P Probe Engine)&lt;br&gt;──────────&lt;br&gt;双栈隔离 Socket + 15s 保活&lt;br&gt;打洞→窗口小包测延迟曲线&lt;br&gt;&lt;font color=&quot;#4B5563&quot;&gt;v1.4+ 扩 QUIC/猜端口/TCP&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="184" x="828" y="276" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-10" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#1D4ED8;strokeWidth=1.5;fontColor=#1E3A8A;labelBackgroundColor=#FFFFFF;labelBorderColor=#BFDBFE;fontSize=11;" target="yUIRf83ZdSQaIbvJiAPY-4" value="下发指令 / 订阅 AssessmentState 快照">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-11" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.1;exitY=1;entryX=0.5;entryY=0;strokeColor=#15803D;strokeWidth=1.5;" target="yUIRf83ZdSQaIbvJiAPY-5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-12" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.3;exitY=1;entryX=0.5;entryY=0;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;" target="yUIRf83ZdSQaIbvJiAPY-6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-13" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;" target="yUIRf83ZdSQaIbvJiAPY-7">
          <mxGeometry relative="1" as="geometry" />
