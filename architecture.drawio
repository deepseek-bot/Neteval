        <mxCell id="yUIRf83ZdSQaIbvJiAPY-14" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0;strokeColor=#15803D;strokeWidth=1.5;" target="yUIRf83ZdSQaIbvJiAPY-8">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-15" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-2" source="yUIRf83ZdSQaIbvJiAPY-4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.9;exitY=1;entryX=0.5;entryY=0;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;" target="yUIRf83ZdSQaIbvJiAPY-9">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF2FF;strokeColor=#4F46E5;strokeWidth=1.5;dashed=1;dashPattern=4 4;fontColor=#1E1B4B;fontSize=12;align=left;spacingLeft=12;spacingRight=10;" value="&lt;b&gt;crates/protocol（公共类型字典）&lt;/b&gt;&lt;br&gt;────────────────────&lt;br&gt;&lt;font color=&quot;#3730A3&quot;&gt;仅编译期被服务端与客户端共同引用&lt;/font&gt;&lt;br&gt;• 非运行期业务模块（零逻辑、零调用）&lt;br&gt;• 统一锁死字段名、错误码与 JSON 契约&lt;br&gt;• 靠 Rust 编译器防止编码 Agent 协议漂移" vertex="1">
          <mxGeometry height="164" width="290" x="1470" y="284" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1E1B4B;fontSize=12;spacing=6;" value="&lt;b&gt;Peer Client（朋友设备）[v1.1]&lt;/b&gt;&lt;br&gt;运行相同 Client App&lt;br&gt;（CLI / Windows EXE / Android APK）&lt;br&gt;&lt;font color=&quot;#6B21A8&quot;&gt;默认 IPv6 优先（含直采），回退 IPv4&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="260" x="1500" y="560" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-18" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#E2E8F0;strokeColor=#475569;strokeWidth=1.5;fontColor=#0F172A;fontSize=12;" value="&lt;b&gt;客户端本地磁盘&lt;/b&gt;&lt;br&gt;JSON 历史报告&lt;br&gt;&lt;i&gt;(v1.7+ 自定义节点清单)&lt;/i&gt;" vertex="1">
          <mxGeometry height="114" width="184" x="388" y="840" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#475569;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#0F172A;fontSize=12;spacing=6;" value="&lt;b&gt;目标公网节点 [v1.3]&lt;/b&gt;&lt;br&gt;Cloudflare 边缘 IP&lt;br&gt;自有 VPS / 数据中心 IP&lt;br&gt;Steam 类直连服务节点" vertex="1">
          <mxGeometry height="114" width="184" x="588" y="840" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-20" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=32;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;rounded=1;arcSize=4;fontColor=#9A3412;fontSize=13;swimlaneFillColor=#FFF7ED;" value="&lt;b&gt;Linux Probe Server（单文件编译，1C1G 低配小鸡，完全无状态 / 零数据库 / 零落盘）&lt;/b&gt;" vertex="1">
          <mxGeometry height="296" width="714" x="796" y="792" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-21" parent="yUIRf83ZdSQaIbvJiAPY-20" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#FFEDD5;strokeColor=#EA580C;strokeWidth=1.5;rounded=1;fontColor=#9A3412;fontSize=12;swimlaneFillColor=#FFEDD5;" value="&lt;b&gt;Server A：主节点 VPS [v1.0 增强 / v1.1 必需]&lt;/b&gt;" vertex="1">
          <mxGeometry height="202" width="430" x="16" y="42" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-22" parent="yUIRf83ZdSQaIbvJiAPY-21" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1F2937;fontSize=11;spacing=4;" value="&lt;b&gt;S1：信令协调 [v1.1]&lt;/b&gt;&lt;br&gt;(Signaling Server)&lt;br&gt;──────────&lt;br&gt;固定 1 个 WS 端口&lt;br&gt;内存临时房间 (上限64)&lt;br&gt;等友 120s / 打洞守卫 8s&lt;br&gt;&lt;i&gt;与 S2 零互调&lt;/i&gt;" vertex="1">
          <mxGeometry height="148" width="190" x="14" y="38" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-23" parent="yUIRf83ZdSQaIbvJiAPY-21" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EA580C;strokeWidth=2;fontColor=#111827;fontSize=11;spacing=4;" value="&lt;b&gt;S2：地址回显主节点 [v1.0 双端口]&lt;/b&gt;&lt;br&gt;(Echo Responder · 无状态)&lt;br&gt;──────────&lt;br&gt;v1.0：固定双 UDP (v4/v6)&lt;br&gt;支持换端口回包细分 NAT3&lt;br&gt;包体 &amp;lt;=256B / 可选 Token&lt;br&gt;&lt;i&gt;与 S1 零互调&lt;/i&gt;" vertex="1">
          <mxGeometry height="148" width="190" x="226" y="38" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-24" parent="yUIRf83ZdSQaIbvJiAPY-20" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;rounded=1;fontColor=#374151;fontSize=12;swimlaneFillColor=#F3F4F6;" value="&lt;b&gt;Server B：辅节点 VPS [可选]&lt;/b&gt;" vertex="1">
          <mxGeometry height="202" width="224" x="472" y="42" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-25" parent="yUIRf83ZdSQaIbvJiAPY-24" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#6B7280;strokeWidth=1.5;dashed=1;dashPattern=6 4;fontColor=#1F2937;fontSize=11;spacing=4;" value="&lt;b&gt;S2：地址回显辅节点 [可选]&lt;/b&gt;&lt;br&gt;(Echo Helper · 无状态)&lt;br&gt;──────────&lt;br&gt;固定 1 个 IPv4 UDP 端口&lt;br&gt;仅严格区分 NAT1/NAT2 时启用&lt;br&gt;仅接受带 Token 换 IP 指令&lt;br&gt;缺失时自动降级/用公共 STUN" vertex="1">
          <mxGeometry height="148" width="192" x="16" y="38" as="geometry" />
        </mxCell>
        <mxCell id="yUIRf83ZdSQaIbvJiAPY-26" edge="1" parent="yUIRf83ZdSQaIbvJiAPY-20" source="yUIRf83ZdSQaIbvJiAPY-23" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;strokeColor=#DC2626;strokeWidth=1.5;fontColor=#991B1B;labelBackgroundColor=#FFF7ED;labelBorderColor=#FECACA;fontSize=11;" target="yUIRf83ZdSQaIbvJiAPY-25" value="[可选] 带 Token 换 IP 通知：仅回 1 个极小包 (&amp;lt;=128B，防反射放大)">
